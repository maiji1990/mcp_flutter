<?xml version="1.0" encoding="utf-8"?>
<!--
  The WebView demo fixture is served by the app's own loopback HTTP server.
  Cleartext is permitted for loopback names only: the rest of the app (and the
  MCP endpoint, which only listens) keeps Android's HTTPS-only default.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
